# Copy this file to .env and fill in your Confluent Cloud credentials.
# Never commit .env — it is listed in .gitignore.

# ──────────────────────────────────────────────
# Confluent Cloud identifiers
# ──────────────────────────────────────────────
# Found in the Confluent Cloud console under
# "Organization settings" > "Organization ID"
export CONFLUENT_ORG_ID=your-org-uuid-here

# Found under "Environments" — click your environment to see its ID
export CONFLUENT_ENV_ID=env-xxxxxx

# The cloud provider and region where your Flink compute pool lives
export CONFLUENT_CLOUD_PROVIDER=aws
export CONFLUENT_CLOUD_REGION=us-east-2

# ──────────────────────────────────────────────
# Flink Region API credentials
# ──────────────────────────────────────────────
# These are FLINK REGION credentials, not control-plane API keys.
# Create them in the Confluent Cloud console:
#   Flink > Compute Pools > your pool > API Keys > Create key
export CONFLUENT_FLINK_API_KEY=your-flink-api-key
export CONFLUENT_FLINK_API_SECRET=your-flink-api-secret

# ──────────────────────────────────────────────
# Flink compute pool
# ──────────────────────────────────────────────
# Found under "Flink" > "Compute Pools" — the ID starts with "lfcp-"
export CONFLUENT_COMPUTE_POOL_ID=lfcp-xxxxxx

# ──────────────────────────────────────────────
# Flink database (Kafka cluster name)
# ──────────────────────────────────────────────
# The Flink database name maps to an existing Kafka cluster within your
# Confluent Cloud environment. Find it under "Environments" > your cluster.
export CONFLUENT_DBNAME=your-kafka-cluster-name

# ──────────────────────────────────────────────
# dbt profile location
# ──────────────────────────────────────────────
# Points dbt at the profiles.yml committed in this repo, so no copy step
# into ~/.dbt is needed.
export DBT_PROFILES_DIR=$PWD/.dbt
